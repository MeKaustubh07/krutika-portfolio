# Copy this file to studio/.env and fill in your own values. Never commit .env.
# Project ID: sanity.io/manage -> your project -> "Project ID"
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Only needed for `npm run seed` (one-off import). Create at
# sanity.io/manage -> API -> Tokens -> "Add API token" (Editor). Delete it after seeding.
SANITY_WRITE_TOKEN=
